<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_control</name>
  <version>0.2.0</version>
  <description>Bringup and swarm commander between the Unity MR UI and Crazyswarm2 (MSc thesis: MR UI for UAV swarm control).</description>
  <maintainer email="kavinaya2409@gmail.com">Kavinaya</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>crazyflie</exec_depend>
  <exec_depend>crazyflie_sim</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>crazyflie_interfaces</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
