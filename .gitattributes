# Normalise line endings for text; keep shell scripts LF (they run in Linux/Docker)
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf

# Unity YAML assets: use Unity Smart Merge if configured (otherwise normal git merge)
*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.asset merge=unityyamlmerge
*.mat merge=unityyamlmerge
*.anim merge=unityyamlmerge
*.controller merge=unityyamlmerge


# Large binary assets -> Git LFS
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
